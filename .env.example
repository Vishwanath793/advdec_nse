# Copy to .env and supply your own key. Never commit .env.
OPENAI_API_KEY=your_openai_api_key_here
# GPT-4.1 has a large context window for two full broadcast transcripts.
OPENAI_MODEL=gpt-4.1
TV_BROWSER_HEADLESS=true
# Optional: use installed Chrome instead of Playwright Chromium.
# TV_BROWSER_CHANNEL=chrome
PORT=3001

# AI Analyst (docs/ai-analyst.md). Off by default; the app runs without it.
# off | openai | mock (offline, free, template answers)
AI_PROVIDER=off
AI_API_KEY=
# AI_MODEL=gpt-6.1-sol
# AI_EMBEDDING_MODEL=text-embedding-3-small
# AI_DAILY_TOKEN_BUDGET=300000
# AI_DAILY_CALL_BUDGET=300
# Optional prices (per 1M tokens) for a cost estimate; none is guessed.
# AI_PRICE_INPUT_PER_1M=
# AI_PRICE_OUTPUT_PER_1M=
# AI_PRICE_EMBEDDING_PER_1M=
# AI_PRICE_CURRENCY=USD
# AI_TV_RESEARCH=0
