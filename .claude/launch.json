{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "backend",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "server"],
      "port": 3001
    },
    {
      "name": "frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "port": 5173
    },
    {
      "name": "backend-3002",
      "runtimeExecutable": "cmd",
      "runtimeArgs": ["/c", "set PORT=3002&& npm run server"],
      "port": 3002
    },
    {
      "name": "frontend-3002",
      "runtimeExecutable": "cmd",
      "runtimeArgs": ["/c", "set BACKEND_PORT=3002&& npm run dev"],
      "port": 5173
    },
    {
      "name": "backend-3002-ai-mock",
      "runtimeExecutable": "cmd",
      "runtimeArgs": ["/c", "set PORT=3002&& set AI_PROVIDER=mock&& npm run server"],
      "port": 3002
    },
    {
      "name": "frontend-5174",
      "runtimeExecutable": "cmd",
      "runtimeArgs": ["/c", "set BACKEND_PORT=3002&& npx vite --port 5174 --strictPort"],
      "port": 5174
    }
  ]
}
