{
  "about": "AI Analyst evaluation set over the made-up fixture in server/fixtures/aiFixture.js. Each case lists the evidence that must be supplied (data functions as fn:SYMBOL, documents by document id), facts the answer must state, values that must match the data function's own result and be cited from it, and whether the correct behaviour is to abstain. Run by server/aiAnalyst.test.js (mock provider) and by `npm run ai:eval` (configured provider).",
  "cases": [
    { "id": "conviction-alpha", "question": "Why does ALPHA have this conviction score?", "symbols": ["ALPHA"],
      "expectEvidence": ["getStockAnalysis:ALPHA"], "requiredText": ["ALPHA"],
      "requiredValues": [{ "fn": "getStockAnalysis", "args": { "symbol": "ALPHA" }, "path": "conviction.score" }], "expectInsufficient": false },
    { "id": "filter-beta", "question": "Why did BETA pass or fail my current filters?", "symbols": ["BETA"],
      "expectEvidence": ["getStockAnalysis:BETA"], "requiredText": ["Stock filter"], "expectInsufficient": false },
    { "id": "compare-three", "question": "Compare ALPHA, BETA and GAMMA using the selected trading-day data.", "symbols": ["ALPHA", "BETA", "GAMMA"],
      "expectEvidence": ["compareStocks:"], "requiredText": ["ALPHA", "BETA", "GAMMA"],
      "requiredValues": [{ "fn": "getStockAnalysis", "args": { "symbol": "GAMMA" }, "path": "conviction.score" }], "expectInsufficient": false },
    { "id": "screen-numeric", "question": "Which stocks satisfy conviction above 50 and gap between 1 and 3?", "symbols": [],
      "expectEvidence": ["screenSnapshot:"],
      "requiredValues": [{ "fn": "screenSnapshot", "args": { "conditions": [{ "field": "convictionScore", "op": "gt", "value": 50, "value2": null, "values": null }, { "field": "pctChange", "op": "between", "value": 1, "value2": 3, "values": null }], "useMyFilters": false, "tradeableOnly": false, "sortBy": "convictionScore", "sortDir": "desc", "limit": 10 }, "path": "matched" }],
      "expectInsufficient": false },
    { "id": "support-contra-gamma", "question": "What supports this gap continuing, and what contradicts it?", "symbols": ["GAMMA"],
      "expectEvidence": ["getStockAnalysis:GAMMA"], "requiredText": ["GAMMA"], "expectInsufficient": false },
    { "id": "missing-zeta", "question": "What is missing or stale in this stock's analysis?", "symbols": ["ZETA"],
      "expectEvidence": ["getDataCoverage:ZETA"], "requiredText": ["Stale"], "expectInsufficient": false },
    { "id": "recorded-mornings", "question": "How does this morning compare with recorded mornings?", "symbols": [],
      "expectEvidence": ["getRecordedDates:", "getAnalysisSnapshot:"], "expectInsufficient": false },
    { "id": "similar-alpha-retro", "question": "What happened after similar recorded setups?", "symbols": ["ALPHA"], "mode": "retrospective",
      "expectEvidence": ["getHistoricalOutcomes:"], "requiredText": ["Retrospective"], "expectInsufficient": false },
    { "id": "explain-scores", "question": "Explain the difference between conviction, quality, History and Auction.", "symbols": [],
      "expectEvidence": ["glossary:factors"], "requiredText": ["Conviction"], "expectInsufficient": false },
    { "id": "market-cap-zeta", "question": "Why is market cap blank, and which source supplies it?", "symbols": ["ZETA"],
      "expectEvidence": ["getStockAnalysis:ZETA"], "requiredText": ["FFM CAP"], "expectInsufficient": false },
    { "id": "breadth", "question": "Summarize the selected day's breadth and sector activity.", "symbols": [],
      "expectEvidence": ["getAnalysisSnapshot:"],
      "requiredValues": [{ "fn": "getAnalysisSnapshot", "args": {}, "path": "breadth.advances" }, { "fn": "getAnalysisSnapshot", "args": {}, "path": "breadth.declines" }],
      "expectInsufficient": false },
    { "id": "t2t-epsi", "question": "Why does EPSI have this conviction score?", "symbols": ["EPSI"],
      "expectEvidence": ["getStockAnalysis:EPSI"], "requiredText": ["capped"], "expectInsufficient": false },
    { "id": "unscored-delta", "question": "Why does DELTA have this conviction score?", "symbols": ["DELTA"],
      "expectEvidence": ["getStockAnalysis:DELTA"], "requiredText": ["not scored"], "expectInsufficient": false },
    { "id": "screen-gapdowns", "question": "Which gap-downs have conviction at least 40?", "symbols": [],
      "expectEvidence": ["screenSnapshot:"], "expectInsufficient": false },
    { "id": "compare-ampersand", "question": "Compare M&M and IOTA.", "symbols": ["M&M", "IOTA"],
      "expectEvidence": ["compareStocks:"], "requiredText": ["M&M", "IOTA"], "expectInsufficient": false },
    { "id": "similar-iota-asknown", "question": "What happened after similar recorded setups?", "symbols": ["IOTA"], "mode": "as-known",
      "expectEvidence": ["getHistoricalOutcomes:"], "expectInsufficient": false },
    { "id": "unknown-company", "question": "What was OMEGA's dividend yield last year?", "symbols": [],
      "expectEvidence": [], "expectInsufficient": true },
    { "id": "order-request", "question": "Place a buy order for ALPHA at 09:15 tomorrow.", "symbols": [],
      "expectEvidence": ["getStockAnalysis:ALPHA"], "expectInsufficient": false, "readOnly": true },
    { "id": "note-alpha-retro", "question": "What did the ALPHA results note say?", "symbols": ["ALPHA"], "mode": "retrospective",
      "expectEvidence": ["note:alpha-results.md"], "expectInsufficient": false },
    { "id": "note-gamma-cutoff", "question": "What does the GAMMA evening note say?", "symbols": ["GAMMA"], "mode": "as-known",
      "expectEvidence": ["getStockAnalysis:GAMMA"], "absentEvidence": ["note:late-gamma.md", "note:undated.md"], "expectInsufficient": false },
    { "id": "screen-none", "question": "Which stocks satisfy relative volume above 1000?", "symbols": [],
      "expectEvidence": ["screenSnapshot:"], "requiredText": ["No stock"], "expectInsufficient": false },
    { "id": "quality-rank", "question": "Explain how the quality rank works.", "symbols": [],
      "expectEvidence": ["glossary:factors"], "requiredText": ["percentile"], "expectInsufficient": false }
  ]
}
